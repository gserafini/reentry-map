{
  "private": true,
  "scripts": {
    "tailwind:build": "node node_modules/tailwindcss/lib/cli.js -i ./styles/tailwind-input.css -o ./styles/tailwind.css --minify",
    "tailwind:watch": "node node_modules/tailwindcss/lib/cli.js -i ./styles/tailwind-input.css -o ./styles/tailwind.css --watch",
    "dev": "(lsof -ti:3003 | xargs kill -9 2>/dev/null || true) && rm -rf .next && concurrently \"npm:tailwind:watch\" \"node node_modules/next/dist/bin/next dev --webpack --port 3003\"",
    "dev:test": "(lsof -ti:3004 | xargs kill -9 2>/dev/null || true) && rm -rf .next && concurrently \"npm:tailwind:watch\" \"node node_modules/next/dist/bin/next dev --webpack --port 3004\"",
    "build": "npm run tailwind:build && next build --webpack",
    "build:analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen --webpack && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "SKIP_ENV_VALIDATION=true vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "SKIP_ENV_VALIDATION=true vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:a11y:ui": "playwright test e2e/accessibility.spec.ts --ui",
    "dev:check": "bash scripts/check-dev-compile.sh",
    "console:check": "bash scripts/check-console.sh",
    "quality": "npm run lint && npm run typecheck && npm run test:run && npm run build && npm run console:check",
    "quality:full": "npm run quality && npm run test:e2e",
    "quality:a11y": "npm run lint && npx tsc --noEmit && npm run test:a11y",
    "screenshots": "bash scripts/screenshot.sh",
    "screenshot:bulk": "node scripts/bulk-capture-screenshots.mjs",
    "screenshot:bulk:updateall": "node scripts/bulk-capture-screenshots.mjs --force",
    "verify:periodic": "node scripts/periodic-verification.mjs",
    "verify:periodic:dry-run": "node scripts/periodic-verification.mjs --dry-run",
    "verify:check-ip-blocks": "node scripts/check-ip-blocks.mjs",
    "import:resources": "node scripts/import-resource-files.mjs",
    "admin": "node scripts/admin-cli.mjs",
    "geoip:update": "node node_modules/geoip-lite/scripts/updatedb.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@mui/material-nextjs": "^7.3.10",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.4",
    "geoip-lite": "^2.0.3",
    "ipaddr.js": "^2.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "next": "16.4.5",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "patchright": "^1.59.4",
    "pg": "^8.23.1",
    "postgres": "^3.4.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.3.0",
    "twilio": "^5.13.1",
    "use-debounce": "^10.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@next/bundle-analyzer": "16.4.5",
    "@next/swc-wasm-nodejs": "16.4.5",
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/crypto-js": "^4.2.2",
    "@types/geoip-lite": "^1.4.4",
    "@types/google.maps": "3.58.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.2.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild": false,
    "unrs-resolver": false
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
